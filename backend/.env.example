# ==============================================================================
# HireSense Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values for your deployment.
# ==============================================================================

# Database Connection URL:
# - Local SQLite: sqlite:///./hiresense.db
# - Production PostgreSQL: postgresql://hiresense_user:SecretPassword@localhost:5432/hiresense_prod
DATABASE_URL=sqlite:///./hiresense.db

# JWT Security & Secret Key (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Directory
UPLOAD_DIR=uploads

# Cross-Origin Resource Sharing (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://localhost:3000", "http://localhost:80", "http://127.0.0.1:5173"]

# Speech-to-Text Configuration
# Options: "local" (uses whisper model locally) or "mock" (for fast CI testing)
WHISPER_MODEL_SIZE=base

# Optional Cloud LLM / STT API Keys (If integrating OpenAI / Anthropic / Gemini directly)
OPENAI_API_KEY=
GEMINI_API_KEY=
